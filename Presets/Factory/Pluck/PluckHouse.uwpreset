<?xml version="1.0" encoding="UTF-8"?>
<!-- Pluck: todo el sonido es la caída. Env 1 sin sustain + Env 2 rápida abriendo un low-pass, y un eco galopante. -->
<UndertowPreset formatVersion="1" name="Pluck House" category="Pluck" author="Undertow">
  <Notes>
    Pluck brillante de house y progressive (124 BPM).

    Cómo se construyó:
    - Osc A: sierra con Unison 3, Detune 15 %, Width 70 %: algo de anchura sin perder el ataque.
    - Osc B: otra sierra una octava arriba (Level 40 %): más brillo en el "pic" y más cuerpo en notas tan cortas.
    - Env 1: Attack 1 ms, Decay 500 ms, Sustain 0 %, Release 300 ms. Sin sustain la nota se apaga sola aunque
      mantengas la tecla: toda la forma la da el decay (la receta de pluck de la Fase 2).
    - Low Pass 24 dB a 800 Hz, Resonance 30 %, Key Track 60 %: las notas agudas no se apagan cuando el filtro
      se cierra.
    - Env 2 (Attack 1 ms, Decay 220 ms, Sustain 0 %) → Cutoff +45 %: cada nota empieza 4.5 octavas más brillante
      (de 800 Hz a ~18 kHz) y se cierra enseguida, y se oye un "pic". El filtro cae ANTES que el volumen, igual que
      en una cuerda pulsada: los armónicos agudos mueren primero.
    - Velocity → Cutoff +12 % y Velocity Sens 60 %: tocar fuerte = más fuerte y más brillante.
    - Delay 1/8 D ping-pong (Feedback 30 %, Tone 45 %, Mix 22 %) y reverb corta (Decay 1.5 s, Mix 18 %).

    Tócalo: arpegios en corcheas entre C5 y C6 (por ejemplo, un acorde de Am7 nota a nota).
    Prueba a mover: el Decay de Env 2 (100 ms = "pic" seco; 500 ms = "piuu" más largo) y la Resonance.
  </Notes>
  <Parameters>
    <PARAM id="oscAPosition" value="0.6667"/>
    <PARAM id="oscAUnison" value="3"/>
    <PARAM id="oscADetune" value="0.15"/>
    <PARAM id="oscAWidth" value="0.7"/>
    <PARAM id="oscBOn" value="On"/>
    <PARAM id="oscBWavetable" value="Basic Shapes"/>
    <PARAM id="oscBPosition" value="0.6667"/>
    <PARAM id="oscBOctave" value="1"/>
    <PARAM id="oscBLevel" value="0.4"/>

    <PARAM id="voices" value="8"/>
    <PARAM id="velocity" value="0.6"/>
    <PARAM id="attack" value="0.001"/>
    <PARAM id="decay" value="0.5"/>
    <PARAM id="sustain" value="0"/>
    <PARAM id="release" value="0.3"/>

    <PARAM id="filter1On" value="On"/>
    <PARAM id="filter1Type" value="Low Pass"/>
    <PARAM id="filter1Slope" value="24 dB"/>
    <PARAM id="filter1Cutoff" value="800"/>
    <PARAM id="filter1Resonance" value="0.3"/>
    <PARAM id="filter1KeyTrack" value="0.6"/>

    <PARAM id="env2Attack" value="0.001"/>
    <PARAM id="env2Decay" value="0.22"/>
    <PARAM id="env2Sustain" value="0"/>
    <PARAM id="env2Release" value="0.2"/>
    <PARAM id="mod1Source" value="Env 2"/>
    <PARAM id="mod1Destination" value="Filter Cutoff"/>
    <PARAM id="mod1Amount" value="0.45"/>
    <PARAM id="mod2Source" value="Velocity"/>
    <PARAM id="mod2Destination" value="Filter Cutoff"/>
    <PARAM id="mod2Amount" value="0.12"/>

    <PARAM id="fxDelayOn" value="On"/>
    <PARAM id="fxDelaySync" value="On"/>
    <PARAM id="fxDelayDivision" value="1/8 D"/>
    <PARAM id="fxDelayFeedback" value="0.3"/>
    <PARAM id="fxDelayPingPong" value="On"/>
    <PARAM id="fxDelayTone" value="0.45"/>
    <PARAM id="fxDelayMix" value="0.22"/>
    <PARAM id="fxReverbOn" value="On"/>
    <PARAM id="fxReverbSize" value="0.5"/>
    <PARAM id="fxReverbDecay" value="1.5"/>
    <PARAM id="fxReverbMix" value="0.18"/>
    <PARAM id="master" value="6"/>
  </Parameters>
</UndertowPreset>
