<?xml version="1.0" encoding="UTF-8"?>
<!-- Marimba FM: seno modulado por un seno 4 veces más agudo, con el índice de FM solo en los primeros milisegundos. -->
<UndertowPreset formatVersion="1" name="Marimba FM" category="Pluck" author="Undertow">
  <Notes>
    Marimba de madera hecha con FM (tropical house, afrobeat, ambient).

    Cómo se construyó:
    - Osc A: seno (Basic Shapes 0 %) con FM: Osc B. Amount base 0 %: sin la envolvente, solo suena el seno.
    - Osc B (apagado, solo modula): seno dos octavas arriba (ratio 4:1). Al ser una ratio entera, las bandas
      laterales caen en armónicos y el tono queda afinado.
    - Env 2 (Attack 1 ms, Decay 60 ms, Sustain 0 %) → Osc A FM/RM +35 %: un destello de armónicos en los primeros
      milisegundos y después un seno casi puro. Ese "toc" es el golpe de la baqueta sobre la madera.
    - Velocity → Osc A FM/RM +15 %: un golpe fuerte excita más armónicos, como en el instrumento real.
    - Env 1: Attack 1 ms, Decay 450 ms, Sustain 0 %, Release 400 ms. Velocity Sens 70 %. Voices 8.
    - Reverb pequeña (Size 30 %, Decay 1 s, Mix 15 %): una sala de madera.

    Tócalo: patrones en semicorcheas entre C5 y C7, con velocity variada.
    Prueba a mover: Osc B Octave (+1 = ratio 2:1, más hueco; +3 = 8:1, más "campana") y el Decay de Env 2.
  </Notes>
  <Parameters>
    <PARAM id="oscAFmMode" value="FM: Osc B"/>
    <PARAM id="oscAFmAmount" value="0"/>
    <PARAM id="oscBOn" value="Off"/>
    <PARAM id="oscBWavetable" value="Basic Shapes"/>
    <PARAM id="oscBPosition" value="0"/>       <!-- seno -->
    <PARAM id="oscBOctave" value="2"/>         <!-- ratio 4:1 -->

    <PARAM id="voices" value="8"/>
    <PARAM id="velocity" value="0.7"/>
    <PARAM id="attack" value="0.001"/>
    <PARAM id="decay" value="0.45"/>
    <PARAM id="sustain" value="0"/>
    <PARAM id="release" value="0.4"/>

    <PARAM id="env2Attack" value="0.001"/>
    <PARAM id="env2Decay" value="0.06"/>
    <PARAM id="env2Sustain" value="0"/>
    <PARAM id="env2Release" value="0.05"/>
    <PARAM id="mod1Source" value="Env 2"/>
    <PARAM id="mod1Destination" value="Osc A FM/RM"/>
    <PARAM id="mod1Amount" value="0.35"/>
    <PARAM id="mod2Source" value="Velocity"/>
    <PARAM id="mod2Destination" value="Osc A FM/RM"/>
    <PARAM id="mod2Amount" value="0.15"/>

    <PARAM id="fxReverbOn" value="On"/>
    <PARAM id="fxReverbSize" value="0.3"/>
    <PARAM id="fxReverbDecay" value="1"/>
    <PARAM id="fxReverbDamping" value="0.5"/>
    <PARAM id="fxReverbMix" value="0.15"/>
    <PARAM id="master" value="6"/>
  </Parameters>
</UndertowPreset>
