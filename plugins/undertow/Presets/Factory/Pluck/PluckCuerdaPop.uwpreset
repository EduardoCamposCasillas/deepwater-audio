<?xml version="1.0" encoding="UTF-8"?>
<!-- Pluck moderno en capas: la cuerda pone el ataque y la caída naturales, una sierra con unison pone el ancho de synth. -->
<UndertowPreset formatVersion="1" name="Pluck Cuerda Pop" category="Pluck" author="Undertow">
  <Notes>
    Género: pop / house / future bass. Un pluck "híbrido": medio instrumento, medio sintetizador. Cuerda pulsada
    (Fases 12–13) en capa con un oscilador. Es la receta 3 de la Fase 12, terminada.

    Cómo se construyó:
    - Cuerda: Decay 0.8 s, Damping 45 %, Level 70 %. Punteo: Filtered Noise, Pick Tone 6 kHz y Pick Pos 12 %: un
      ataque claro y brillante que corta la mezcla.
    - Osc A: Basic Shapes en sierra (Position 67 %), Level 35 %, Unison 3, Detune 20 %, Width 80 %: la cuerda es mono;
      la sierra desafinada pone el ancho estéreo y el "brillo de synth" que la cuerda sola no tiene.
    - Env 1: Decay 600 ms, Sustain 0 %: la sierra NO sabe apagarse sola como la cuerda, así que la envolvente la
      convierte en pluck. La cuerda ya caía por su cuenta; las dos caídas juntas se funden.
    - Low Pass 24 dB a 2.5 kHz + Env 2 → Cutoff +30 % (decay 150 ms): el brillo dura solo el ataque.
    - Delay 1/8 D ping-pong (Mix 20 %) y reverb mediana.

    Tócalo: a 120 BPM, acordes cortos en corcheas: Am–F–C–G con la tríada en la octava 5 de FL (A5–C6–E6, F5–A5–C6…).
    Prueba a mover: Osc A Level (0 % = solo la cuerda: orgánico pero estrecho; 60 % = la sierra se come la cuerda) y
    Pick Pos de la cuerda (50 % = más "kalimba").
    Técnicas: Fase 3/6 (sierra con unison) + Fase 4/5 (envolvente de filtro) + Fases 12–13 (la cuerda) + Fase 8.
  </Notes>
  <Parameters>
    <PARAM id="oscAPosition" value="0.6667"/>
    <PARAM id="oscALevel" value="0.35"/>
    <PARAM id="oscAUnison" value="3"/>
    <PARAM id="oscADetune" value="0.2"/>
    <PARAM id="oscAWidth" value="0.8"/>

    <PARAM id="stringOn" value="On"/>
    <PARAM id="stringLevel" value="0.7"/>
    <PARAM id="stringDecay" value="0.8"/>
    <PARAM id="stringDamping" value="0.45"/>
    <PARAM id="stringExcitation" value="Filtered Noise"/>
    <PARAM id="stringPickPosition" value="0.12"/>
    <PARAM id="stringPickTone" value="6000"/>

    <PARAM id="voices" value="8"/>
    <PARAM id="velocity" value="0.5"/>
    <PARAM id="attack" value="0.001"/>
    <PARAM id="decay" value="0.6"/>
    <PARAM id="sustain" value="0"/>
    <PARAM id="release" value="0.3"/>

    <PARAM id="filter1On" value="On"/>
    <PARAM id="filter1Type" value="Low Pass"/>
    <PARAM id="filter1Slope" value="24 dB"/>
    <PARAM id="filter1Cutoff" value="2500"/>
    <PARAM id="filter1Resonance" value="0.15"/>
    <PARAM id="filter1KeyTrack" value="0.5"/>

    <PARAM id="env2Attack" value="0.001"/>
    <PARAM id="env2Decay" value="0.15"/>
    <PARAM id="env2Sustain" value="0"/>
    <PARAM id="env2Release" value="0.1"/>
    <PARAM id="mod1Source" value="Env 2"/>
    <PARAM id="mod1Destination" value="Filter Cutoff"/>
    <PARAM id="mod1Amount" value="0.3"/>

    <PARAM id="fxDelayOn" value="On"/>
    <PARAM id="fxDelaySync" value="On"/>
    <PARAM id="fxDelayDivision" value="1/8 D"/>
    <PARAM id="fxDelayFeedback" value="0.3"/>
    <PARAM id="fxDelayPingPong" value="On"/>
    <PARAM id="fxDelayTone" value="0.45"/>
    <PARAM id="fxDelayMix" value="0.2"/>
    <PARAM id="fxReverbOn" value="On"/>
    <PARAM id="fxReverbSize" value="0.5"/>
    <PARAM id="fxReverbDecay" value="1.5"/>
    <PARAM id="fxReverbMix" value="0.16"/>
    <PARAM id="master" value="4.5"/>
  </Parameters>
</UndertowPreset>
