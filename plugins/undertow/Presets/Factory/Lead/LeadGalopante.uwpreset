<?xml version="1.0" encoding="UTF-8"?>
<!-- Lead con eco de 1/8 con puntillo en ping-pong: el delay rellena el ritmo entre las notas. -->
<UndertowPreset formatVersion="1" name="Lead Galopante" category="Lead" author="Undertow">
  <Notes>
    Lead con eco "galopante" (pop, trance).

    Cómo se construyó:
    - Osc A: sierra con Unison 3 y Detune 15 %. Voices 1.
    - Low Pass 12 dB a 5 kHz. Env 1: Attack 3 ms, Decay 300 ms, Sustain 70 %, Release 150 ms.
    - Delay: Sync, 1/8 D (corchea con puntillo), Feedback 35 %, Ping-Pong, Tone 40 %, Mix 25 %. El eco a 3/4 de
      negra cae en los huecos de la melodía y "rellena" el ritmo sin pisar las notas. Oscuro (Tone) y rebotando a
      los lados (Ping-Pong), no compite con el lead del centro.
    - Reverb: Size 50 %, Decay 1.8 s, Pre-Delay 40 ms, Mix 18 %. El pre-delay deja el ataque nítido antes de que
      llegue la sala.

    Tócalo: una melodía en negras y corcheas entre C6 y C7.
    Prueba a mover: la división del delay (1/4 = eco "recto"; 1/8 D = galope) y el Feedback (60 % = las repeticiones
    se acumulan, bueno para un final de frase).
    Viene de: Fase 8 (receta 3).
  </Notes>
  <Parameters>
    <PARAM id="oscAPosition" value="0.6667"/>
    <PARAM id="oscAUnison" value="3"/>
    <PARAM id="oscADetune" value="0.15"/>

    <PARAM id="voices" value="1"/>
    <PARAM id="attack" value="0.003"/>
    <PARAM id="decay" value="0.3"/>
    <PARAM id="sustain" value="0.7"/>
    <PARAM id="release" value="0.15"/>

    <PARAM id="filter1On" value="On"/>
    <PARAM id="filter1Type" value="Low Pass"/>
    <PARAM id="filter1Slope" value="12 dB"/>
    <PARAM id="filter1Cutoff" value="5000"/>

    <PARAM id="fxDelayOn" value="On"/>
    <PARAM id="fxDelaySync" value="On"/>
    <PARAM id="fxDelayDivision" value="1/8 D"/>
    <PARAM id="fxDelayFeedback" value="0.35"/>
    <PARAM id="fxDelayPingPong" value="On"/>
    <PARAM id="fxDelayTone" value="0.4"/>
    <PARAM id="fxDelayMix" value="0.25"/>
    <PARAM id="fxReverbOn" value="On"/>
    <PARAM id="fxReverbSize" value="0.5"/>
    <PARAM id="fxReverbDecay" value="1.8"/>
    <PARAM id="fxReverbDamping" value="0.4"/>
    <PARAM id="fxReverbPreDelay" value="0.04"/>
    <PARAM id="fxReverbMix" value="0.18"/>
    <PARAM id="master" value="6"/>
  </Parameters>
</UndertowPreset>
