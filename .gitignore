# Salidas de CMake / compilación (incluye JUCE descargado en build/_deps)
build/
out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# Binarios sueltos
*.vst3
*.exe
*.dll
*.pdb
*.lib
*.exp
*.obj

# Herramientas descargadas (pluginval)
tools/

# Python (scripts/) y logs de compilación / validación
__pycache__/
*.pyc
*.log

# IDEs y editores
.vs/
.vscode/
.idea/
*.user
*.suo

# Claude Code: configuración local de cada máquina
.claude/settings.local.json

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Proyectos y audio de prueba de FL Studio (pueden incluir samples con copyright). Los WAV de referencia de los null
# tests se generan con los tests de cada plugin (p. ej. UndertowPresetTests --render) y se guardan en out/.
*.flp
*.wav
*.mp3
*.zip

# Credenciales o configuración privada
.env
*.pem
*.key
